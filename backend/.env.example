# Copy to backend/.env for local development. Never commit real values.
BIBBY_ENV=dev
BIBBY_DATABASE_URL=postgresql+asyncpg://bibby:bibby@localhost:5432/bibby
BIBBY_APP_SECRET=CHANGE_ME_at_least_32_random_characters
BIBBY_FIELD_ENCRYPTION_KEY=CHANGE_ME_fernet_key_from_python_-m_app.cli_generate-fernet-key
BIBBY_COOKIE_SECURE=false
BIBBY_CORS_ORIGINS=["http://localhost:5173"]
BIBBY_PUBLIC_BASE_URL=http://localhost:5173
BIBBY_PAYMENT_PROVIDER=fake
BIBBY_MAIL_PROJECT_ID=
BIBBY_MAIL_API_KEY=
BIBBY_MAIL_DEFAULT_SENDER=noreply@example.org
BIBBY_MAIL_TEST_RECIPIENT=test@example.org
BIBBY_BOOTSTRAP_PLATFORM_ADMIN_EMAIL=root@example.org
BIBBY_BOOTSTRAP_PLATFORM_ADMIN_PASSWORD=CHANGE_ME_long_password
